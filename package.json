{
    "name": "yumme",
    "private": true,
    "scripts": {
        "start": "vite",
        "generate:api": "openapi-typescript openapi/yumme.json -o src/api/schema.d.ts",
        "type-check": "tsc --noEmit",
        "types:css": "typed-scss-modules \"src/**/*.module.scss\" --logLevel error",
        "build": "npm run type-check && vite build",
        "preview": "vite preview",
        "lint": "run-p lint:scripts lint:styles",
        "lint:scripts": "eslint \"{src,test}/**/*.{ts,tsx}\"",
        "lint:styles": "stylelint \"{src,test}/**/*.{css,scss}\"",
        "test": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@decorize/bind": "1.0.3",
        "@tabler/icons-react": "3.47.0",
        "inversify": "6.2.2",
        "inversify-react": "1.2.0",
        "jotai": "3.0.0",
        "mobx": "7.0.3",
        "mobx-react": "10.0.2",
        "normalize.css": "8.0.1",
        "openapi-fetch": "0.17.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router-dom": "7.18.4",
        "reflect-metadata": "0.2.2"
    },
    "devDependencies": {
        "@babel/core": "7.20.12",
        "@babel/plugin-proposal-class-properties": "7.18.6",
        "@babel/plugin-proposal-decorators": "7.20.13",
        "@babel/preset-react": "7.18.6",
        "@babel/preset-typescript": "7.18.6",
        "@eslint/js": "9.39.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/node": "22.20.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "@vitest/coverage-v8": "5.0.1",
        "babel-plugin-parameter-decorator": "1.0.16",
        "babel-plugin-transform-typescript-metadata": "0.3.2",
        "eslint": "9.39.5",
        "eslint-import-resolver-typescript": "3.5.3",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-promise": "7.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.12.0",
        "jsdom": "30.1.0",
        "npm-run-all2": "9.0.3",
        "openapi-typescript": "7.13.0",
        "sass": "1.104.1",
        "stylelint": "17.15.0",
        "stylelint-config-standard-scss": "17.0.0",
        "stylelint-scss": "7.3.0",
        "ts-mockito": "2.6.1",
        "typed-scss-modules": "8.1.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    }
}
